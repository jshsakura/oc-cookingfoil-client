diff --git a/include/nx/nca_writer.h b/include/nx/nca_writer.h
index 712833d..5fbc213 100755
--- a/include/nx/nca_writer.h
+++ b/include/nx/nca_writer.h
@@ -114,6 +114,8 @@ public:
 	void hashFrom(const Sha256Context& start) { m_sha = std::make_unique<Sha256Context>(start); }
 	// After close: 1 the written NCA hashes to its id, -1 it does not, 0 not hashed.
 	int hashCheck() const { return m_hashCheck; }
+	u64 hashedBytes() const { return m_hashedBytes; } // what the check hashed, resumed part included
+	virtual bool decompresses() const { return false; } // an NCZ, made whole here
 protected:
 
 	std::vector<u8> m_contentBuffer;
@@ -131,6 +133,7 @@ private:
 	std::shared_ptr<Mark> m_nextMark;
 	std::unique_ptr<Sha256Context> m_sha; // used by the card thread only, then at close
