+}
+
+void NcaBodyWriter::startFlusher()
+{
+     m_flusher = std::thread([this] {
+          std::unique_lock<std::mutex> held(m_flushLock);
+          while (true)
+          {
+               m_flushChanged.wait(held, [this] { return !m_pending.empty() || m_flushStop; });
+               if (m_pending.empty()) return;
+               Pending next = std::move(m_pending.front());
+               m_pending.pop_front();
+               m_flushing = true;
+               held.unlock();
+               std::exception_ptr error;
+               try {
+                    m_contentStorage->WritePlaceholder(*(NcmPlaceHolderId*)&m_ncaId, next.offset, next.data.data(), next.data.size());
+               } catch (...) {
+                    error = std::current_exception();
+               }
+               next.data.clear();
+               held.lock();
+               if (error && !m_flushError) m_flushError = error;
+               if (m_spare.capacity() == 0) m_spare = std::move(next.data);
+               m_flushing = false;
+               m_flushChanged.notify_all();
+          }
+     });
+}
+
+void NcaBodyWriter::drainFlusher()
+{
+     {
+          std::unique_lock<std::mutex> held(m_flushLock);
+          m_flushChanged.wait(held, [this] { return m_pending.empty() && !m_flushing; });
+          m_flushStop = true;
+     }
+     m_flushChanged.notify_all();
+     if (m_flusher.joinable()) m_flusher.join();
+     if (m_flushError)
+     {
+          auto error = m_flushError;
+          m_flushError = nullptr;
+          std::rethrow_exception(error);
+     }
 }
 
